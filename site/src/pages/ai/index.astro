---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('ai'))
  .filter((e: any) => e.data.status !== 'draft')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const essays = entries.filter((e: any) => e.data.kind === 'essay');
const projects = entries.filter((e: any) => e.data.kind === 'project');
const notes = entries.filter((e: any) => e.data.kind === 'note');
const seriesEntries = entries.filter((e: any) => e.data.kind === 'series');

const seriesGroups = Object.values(
  seriesEntries.reduce((acc: Record<string, any[]>, e: any) => {
    const key = e.data.seriesTitle || e.data.title;
    (acc[key] ||= []).push(e);
    return acc;
  }, {})
).map((group: any[]) => group.sort((a, b) => (a.data.part || 0) - (b.data.part || 0)));

const allTags = ['all', ...new Set(entries.flatMap((e: any) => e.data.tags))];
---

<BaseLayout title="AI | Kiran Kumar" description="Essays, projects, notes, and series on AI engineering, LLMs, and agents.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader title="AI" subtitle="Essays, projects, notes, and series on AI engineering, LLMs, and agents." />

    <nav class="mb-10 flex flex-wrap gap-4 overflow-x-auto" id="tag-filters" data-animate>
      {allTags.map(tag => (
        <button data-tag={tag} class={`filter-btn ${tag === 'all' ? 'active' : ''}`}>{tag}</button>
      ))}
    </nav>

    {essays.length > 0 && (
      <section class="mb-16" data-stagger>
        <h2 class="section-label mb-8">Essays</h2>
        {essays.map(p => <div data-tags={p.data.tags.join(',')}><BlogCard post={p} basePath="/ai" /></div>)}
      </section>
    )}

    {projects.length > 0 && (
      <section class="mb-16" data-stagger>
        <h2 class="section-label mb-8">Projects</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {projects.map(p => <div data-tags={p.data.tags.join(',')}><BlogCard post={p} basePath="/ai" /></div>)}
        </div>
      </section>
    )}

    {notes.length > 0 && (
      <section class="mb-16" data-stagger>
        <h2 class="section-label mb-8">Notes</h2>
        <ul>
          {notes.map(p => (
            <li class="mb-6" data-tags={p.data.tags.join(',')}>
              <a href={`/ai/${p.slug}`} class="hover-underline inline-block" style="font-family: var(--font-heading); color: var(--color-text);">
                <span class="text-lg font-bold">{p.data.title}</span>
              </a>
              <p class="text-sm mt-1" style="color: var(--color-text-secondary);">{p.data.excerpt}</p>
              <span class="tag-editorial">{p.data.date}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {seriesGroups.length > 0 && (
      <section class="mb-16" data-stagger>
        <h2 class="section-label mb-8">Series</h2>
        {seriesGroups.map(group => (
          <div class="mb-8">
            <h3 class="text-xl font-bold mb-3" style="font-family: var(--font-heading); color: var(--color-text);">
              {group[0].data.seriesTitle}
            </h3>
            <ol>
              {group.map(p => (
                <li class="mb-2" data-tags={p.data.tags.join(',')}>
                  <a href={`/ai/${p.slug}`} class="hover-underline inline-block" style="color: var(--color-accent);">
                    Part {p.data.part}: {p.data.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    )}

  </div>
</BaseLayout>

<script is:inline>
  (function() {
    var buttons = document.querySelectorAll('#tag-filters .filter-btn');
    var items = document.querySelectorAll('[data-tags]');
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tag = btn.getAttribute('data-tag');
        buttons.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        items.forEach(function(el) {
          var tags = (el.getAttribute('data-tags') || '').split(',');
          el.style.display = (tag === 'all' || tags.indexOf(tag) !== -1) ? '' : 'none';
        });
      });
    });
  })();
</script>
