---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { resources } from '../data/resources.js';

const categories = [...new Set(resources.map((r: any) => r.category))];
const allFilters = ['All', ...categories];
---

<BaseLayout title="Resources | Kiran Kumar" description="Curated guides, templates, and references for data engineering professionals.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader title="Resources" subtitle="Curated collection of guides, templates, and references for data engineering professionals." />

    <!-- Category filters -->
    <nav class="mb-10 flex flex-wrap gap-4" id="category-filters" data-animate>
      {allFilters.map((cat) => (
        <button
          data-category={cat}
          class={`filter-btn ${cat === 'All' ? 'active' : ''}`}
        >
          {cat}
        </button>
      ))}
    </nav>

    <!-- Resources grouped by category -->
    <div id="resources-list">
      {categories.map((category: string) => (
        <section data-cat-section={category} class="mb-12">
          <h2
            class="section-label mb-6"
            style="color: var(--color-accent);"
          >
            {category}
          </h2>

          <div data-stagger>
            {resources
              .filter((r: any) => r.category === category)
              .map((resource: any, i: number) => (
                <div
                  class="py-5"
                  data-resource-category={resource.category}
                  style={`border-bottom: 1px solid var(--color-border);`}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-grow">
                      <h3
                        class="text-lg font-bold mb-1"
                        style={`font-family: var(--font-heading); color: var(--color-text);`}
                      >
                        {resource.title}
                      </h3>

                      <p
                        class="text-base mb-2"
                        style={`font-family: var(--font-body); color: var(--color-text-secondary);`}
                      >
                        {resource.description}
                      </p>

                      {resource.downloadLink && (
                        <a
                          href={resource.downloadLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover-underline text-sm font-medium"
                          style={`font-family: var(--font-heading); color: var(--color-accent-secondary);`}
                        >
                          {resource.type === 'External' ? 'Visit Resource' : 'Download'}
                        </a>
                      )}
                    </div>

                    <span class="tag-editorial flex-shrink-0 mt-1">
                      {resource.type}
                    </span>
                  </div>
                </div>
              ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#category-filters .filter-btn');
  const sections = document.querySelectorAll<HTMLElement>('[data-cat-section]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');

      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      sections.forEach(section => {
        const sectionCat = section.getAttribute('data-cat-section');
        section.style.display = (cat === 'All' || sectionCat === cat) ? '' : 'none';
      });
    });
  });
</script>
