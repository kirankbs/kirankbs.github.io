---
import BaseLayout from '../layouts/BaseLayout.astro';
import { upcomingEvents, pastEvents } from '../data/events.js';
---

<BaseLayout title="Events | Kiran Kumar" description="Speaking engagements, workshops, and community events focused on data engineering.">
  <div class="min-h-screen bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">Events & Workshops</h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-3xl">
          Speaking engagements, workshops, and community events focused on data engineering excellence.
        </p>
      </div>

      <section class="mb-16">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Upcoming Events</h2>
        {upcomingEvents.length > 0 ? (
          <div class="space-y-6">
            {upcomingEvents.map((event: any) => (
              <div class="bg-gradient-to-br from-cyan-50 to-blue-50 dark:from-slate-900 dark:to-slate-800 border border-cyan-200 dark:border-cyan-800 rounded-xl p-6">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                  <div class="flex-grow">
                    <div class="flex items-center space-x-2 mb-2">
                      <span class="px-3 py-1 bg-cyan-600 text-white text-xs font-medium rounded-full">{event.type}</span>
                      <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 text-xs font-medium rounded-full">Upcoming</span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{event.title}</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">{event.date} • {event.location}</p>
                    <p class="text-slate-700 dark:text-slate-300">{event.description}</p>
                  </div>
                  <a href={event.registrationLink} class="inline-flex items-center justify-center px-6 py-3 bg-cyan-600 hover:bg-cyan-700 text-white font-medium rounded-lg whitespace-nowrap">
                    Register Now
                  </a>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-slate-600 dark:text-slate-400">No upcoming events at the moment. Check back soon!</p>
        )}
      </section>

      <section>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Past Events</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {pastEvents.map((event: any) => (
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 hover:shadow-lg">
              <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium rounded-full">{event.type}</span>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-3 mb-2">{event.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">{event.date} • {event.location}</p>
              <p class="text-slate-600 dark:text-slate-400 mb-4">{event.description}</p>
              <div class="flex flex-wrap gap-3">
                {event.videoLink && (
                  <a href={event.videoLink} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 text-sm font-medium">
                    Watch Video &rarr;
                  </a>
                )}
                {event.slidesLink && (
                  <a href={event.slidesLink} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 text-sm font-medium">
                    View Slides &rarr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
