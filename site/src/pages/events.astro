---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { upcomingEvents, pastEvents } from '../data/events.js';
---

<BaseLayout title="Events | Kiran Kumar" description="Speaking engagements, workshops, and community events focused on data engineering.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader title="Events & Workshops" subtitle="Speaking engagements, workshops, and community events focused on data engineering excellence." />

    <!-- Upcoming -->
    <section class="mb-16">
      <h2
        class="section-label mb-6"
        style="color: var(--color-accent);"
      >
        Upcoming
      </h2>

      {upcomingEvents.length > 0 ? (
        <div data-stagger>
          {upcomingEvents.map((event: any) => (
            <div
              class="card-hover p-6 mb-4"
              style={`border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: 0.5rem;`}
            >
              <div class="tag-editorial mb-2">{event.type}</div>

              <h3
                class="text-xl font-bold mb-2"
                style={`font-family: var(--font-heading); color: var(--color-text);`}
              >
                {event.title}
              </h3>

              <p class="text-sm mb-3" style={`font-family: var(--font-mono); color: var(--color-text-secondary);`}>
                {event.date} &middot; {event.location}
              </p>

              <p class="text-base mb-4" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
                {event.description}
              </p>

              {event.registrationLink ? (
                <a
                  href={event.registrationLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="arrow-link text-sm font-medium"
                  style={`font-family: var(--font-heading); color: var(--color-accent);`}
                >
                  Register <span class="arrow">&rarr;</span>
                </a>
              ) : (
                <span
                  class="text-sm"
                  style={`font-family: var(--font-mono); color: var(--color-text-secondary);`}
                >
                  Registration TBA
                </span>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p style={`color: var(--color-text-secondary); font-family: var(--font-body);`}>
          No upcoming events at the moment. Check back soon.
        </p>
      )}
    </section>

    <!-- Past Events — Timeline -->
    <section>
      <h2
        class="section-label mb-8"
        style="color: var(--color-text-secondary);"
      >
        Past
      </h2>

      <div class="relative" style={`padding-left: 2rem;`} data-stagger>
        <!-- Timeline line -->
        <div
          class="absolute top-0 bottom-0"
          style={`left: 7px; width: 1px; background: var(--color-border);`}
        />

        {pastEvents.map((event: any) => (
          <div class="relative pb-10">
            <!-- Timeline dot -->
            <div
              class="absolute"
              style={`left: -2rem; top: 0.35rem; width: 15px; height: 15px; border-radius: 50%; border: 2px solid var(--color-border); background: var(--color-bg);`}
            />

            <span
              class="tag-editorial block mb-1"
              style="color: var(--color-text-secondary);"
            >
              {event.date}
            </span>

            <h3
              class="text-lg font-bold mb-1"
              style={`font-family: var(--font-heading); color: var(--color-text);`}
            >
              {event.title}
            </h3>

            <p class="text-sm mb-2" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
              {event.location}
            </p>

            <p class="text-base mb-3" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
              {event.description}
            </p>

            <div class="flex flex-wrap gap-4">
              {event.videoLink && (
                <a
                  href={event.videoLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="arrow-link text-sm font-medium"
                  style={`font-family: var(--font-heading); color: var(--color-accent-secondary);`}
                >
                  Watch Video <span class="arrow">&rarr;</span>
                </a>
              )}
              {event.slidesLink && (
                <a
                  href={event.slidesLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="arrow-link text-sm font-medium"
                  style={`font-family: var(--font-heading); color: var(--color-accent-secondary);`}
                >
                  View Slides <span class="arrow">&rarr;</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
