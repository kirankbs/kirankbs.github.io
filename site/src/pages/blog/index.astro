---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const allTags = ['all', ...new Set(posts.flatMap(p => p.data.tags))];
---

<BaseLayout title="Blog | Kiran Kumar" description="Technical articles on data engineering, Apache Spark, Delta Lake and Databricks.">
  <div class="min-h-screen bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">Blog</h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-3xl mb-3">
          Technical deep dives, architecture patterns, and best practices in data engineering.
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-500">
          Also published on
          <a href="https://medium.com/@kirankbs" target="_blank" rel="noopener noreferrer" class="text-cyan-600 dark:text-cyan-400 hover:underline">Medium</a>
          ·
          <a href="https://newsletter.kirankbs.com/" target="_blank" rel="noopener noreferrer" class="text-cyan-600 dark:text-cyan-400 hover:underline">Newsletter</a>
        </p>
      </div>

      <div class="mb-8 flex flex-wrap gap-2" id="tag-filters">
        {allTags.map(tag => (
          <button
            data-tag={tag}
            class={`tag-btn px-4 py-2 rounded-lg text-sm font-medium ${tag === 'all' ? 'bg-cyan-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'}`}
          >
            {tag}
          </button>
        ))}
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
        {posts.map((post) => (
          <article
            class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden hover:shadow-lg hover:border-cyan-300 dark:hover:border-cyan-700"
            data-tags={post.data.tags.join(',')}
          >
            <a href={`/blog/${post.slug}`} class="block p-6">
              <div class="flex items-center space-x-4 text-sm text-slate-500 dark:text-slate-400 mb-3">
                <span>{post.data.date}</span>
                <span>•</span>
                <span>{post.data.readTime}</span>
              </div>
              <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-3 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                {post.data.title}
              </h2>
              <p class="text-slate-600 dark:text-slate-400 mb-4">{post.data.excerpt}</p>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-1 bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 rounded-md">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.tag-btn');
  const articles = document.querySelectorAll('#posts-grid article');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag');

      buttons.forEach(b => b.classList.replace('bg-cyan-600', 'bg-slate-100') || b.classList.replace('text-white', 'text-slate-700'));
      btn.classList.replace('bg-slate-100', 'bg-cyan-600');
      btn.classList.replace('text-slate-700', 'text-white');

      articles.forEach(article => {
        const tags = article.getAttribute('data-tags')?.split(',') ?? [];
        (article as HTMLElement).style.display = (tag === 'all' || tags.includes(tag ?? '')) ? '' : 'none';
      });
    });
  });
</script>
