---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../site.config';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const allTags = ['all', ...new Set(posts.flatMap(p => p.data.tags))];

const featured = posts[0];
const secondary = posts.slice(1, 3);
const rest = posts.slice(3);
---

<BaseLayout title="Blog | Kiran Kumar" description="Technical articles on data engineering, Apache Spark, Delta Lake and Databricks.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader title="Blog" subtitle="Technical deep dives, architecture patterns, and best practices in data engineering." />

    <p class="text-sm mb-10" style="color: var(--color-text-secondary);">
      Also published on
      <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" class="tag-editorial hover-underline">Medium</a>
      &middot;
      <a href={siteConfig.social.newsletter} target="_blank" rel="noopener noreferrer" class="tag-editorial hover-underline">Newsletter</a>
    </p>

    <!-- Tag filters -->
    <nav class="mb-10 flex flex-wrap gap-4 overflow-x-auto" id="tag-filters" data-animate>
      {allTags.map(tag => (
        <button
          data-tag={tag}
          class={`filter-btn ${tag === 'all' ? 'active' : ''}`}
        >
          {tag}
        </button>
      ))}
    </nav>

    <!-- Featured post -->
    {featured && (
      <section data-stagger>
        <article data-tags={featured.data.tags.join(',')}>
          <BlogCard post={featured} featured />
        </article>
      </section>
    )}

    <!-- Secondary 2-col grid -->
    {secondary.length > 0 && (
      <section class="grid md:grid-cols-2 gap-6 mb-8" id="secondary-grid" data-stagger>
        {secondary.map((post) => (
          <article data-tags={post.data.tags.join(',')}>
            <BlogCard post={post} />
          </article>
        ))}
      </section>
    )}

    <!-- Remaining 3-col grid -->
    {rest.length > 0 && (
      <section class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="rest-grid" data-stagger>
        {rest.map((post) => (
          <article data-tags={post.data.tags.join(',')}>
            <BlogCard post={post} />
          </article>
        ))}
      </section>
    )}

  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#tag-filters .filter-btn');
  const articles = document.querySelectorAll<HTMLElement>('article[data-tags]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag');

      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      articles.forEach(article => {
        const tags = article.getAttribute('data-tags')?.split(',') ?? [];
        article.style.display = (tag === 'all' || tags.includes(tag ?? '')) ? '' : 'none';
      });
    });
  });
</script>
