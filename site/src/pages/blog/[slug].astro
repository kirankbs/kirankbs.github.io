---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Kiran Kumar`} description={post.data.excerpt}>
  <article class="min-h-screen bg-white dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <a href="/blog" class="inline-flex items-center text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 mb-8 font-medium">
        &larr; Back to Blog
      </a>

      <header class="mb-8">
        <div class="flex flex-wrap gap-2 mb-4">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-3 py-1 bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 rounded-full">{tag}</span>
          ))}
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">{post.data.title}</h1>
        <div class="flex items-center space-x-4 text-slate-600 dark:text-slate-400">
          <span>{post.data.date}</span>
          <span>•</span>
          <span>{post.data.readTime}</span>
        </div>
      </header>

      <div class="prose prose-slate dark:prose-invert max-w-none">
        <Content />
      </div>

      <footer class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
        <a href="/blog" class="inline-flex items-center text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 font-medium">
          &larr; More Articles
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>
