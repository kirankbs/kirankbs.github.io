---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { certifications } from '../data/certifications.js';

const byYear: Record<string, typeof certifications> = {};
certifications.forEach((cert: any) => {
  const year = cert.date.split(' ').pop() || cert.date;
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(cert);
});

const sortedYears = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
const total = certifications.length;
---

<BaseLayout title="Certifications | Kiran Kumar" description="Professional Databricks certifications in data engineering, ML engineering, and generative AI.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader
      title="Certifications"
      subtitle={`${total} Professional Certifications`}
    />

    <div>
      {sortedYears.map((year) => (
        <section class="mb-12">
          <div class="flex items-center gap-4 mb-6">
            <span
              class="section-label"
              style="color: var(--color-accent);"
            >
              {year}
            </span>
            <div class="flex-grow" style={`height: 1px; background: var(--color-border);`} />
          </div>

          <div data-stagger>
            {byYear[year].map((cert: any) => (
              <div
                class="py-5"
                style={`border-bottom: 1px solid var(--color-border-light);`}
              >
                <div class="flex items-start gap-3">
                  <!-- Verified seal -->
                  <svg
                    class="flex-shrink-0 mt-1"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    style="color: var(--color-accent);"
                  >
                    <path
                      d="M9 12l2 2 4-4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>

                  <div class="flex-grow">
                    <h3
                      class="text-lg font-bold"
                      style={`font-family: var(--font-heading); color: var(--color-text);`}
                    >
                      {cert.link ? (
                        <a href={cert.link} target="_blank" rel="noopener noreferrer" class="hover-underline">
                          {cert.title}
                        </a>
                      ) : (
                        cert.title
                      )}
                    </h3>

                    <p
                      class="text-sm mt-1"
                      style={`font-family: var(--font-body); color: var(--color-text-secondary);`}
                    >
                      {cert.issuer}{cert.description && ` — ${cert.description}`}
                    </p>

                    <span
                      class="tag-editorial mt-2 inline-block"
                      style="color: var(--color-text-secondary);"
                    >
                      {cert.date}
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>
