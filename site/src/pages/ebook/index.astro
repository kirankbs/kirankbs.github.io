---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCover from '../../components/ebook/BookCover.astro';
import { getCollection } from 'astro:content';
import { ebookConfig } from '../../data/ebook';

const chapters = (await getCollection('ebook')).sort(
  (a, b) => a.data.chapter - b.data.chapter
);

const publishedCount = chapters.filter(c => c.data.status === 'published').length;
const latestPublished = chapters
  .filter(c => c.data.status === 'published')
  .sort((a, b) => new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime());

const frontMatter = chapters.filter(c => c.data.chapter === 0);
const partChapters = ebookConfig.parts.map(part => ({
  ...part,
  chapters: chapters.filter(c => c.data.part === part.number),
}));

// Build progress per part
const partProgress = ebookConfig.parts.map(part => {
  const partChs = chapters.filter(c => c.data.part === part.number);
  const pubCount = partChs.filter(c => c.data.status === 'published').length;
  return { total: partChs.length, published: pubCount };
});
---

<BaseLayout
  title="eBook: Spark, Delta Lake, and Databricks in Production | Kiran Kumar"
  description={ebookConfig.description}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">

      <!-- Book Cover -->
      <BookCover publishedCount={publishedCount} />

      <!-- Description -->
      <div class="text-center mb-16" data-animate>
        <p
          class="text-sm max-w-lg mx-auto leading-relaxed"
          style="font-family: var(--font-body); color: var(--color-text-secondary);"
        >
          {ebookConfig.description}
        </p>
      </div>

      <!-- Segmented progress bar -->
      <div class="mb-16" data-animate>
        <div class="flex items-center justify-between mb-3">
          <span class="section-label">Book Progress</span>
          <span class="text-sm" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
            {publishedCount}/{ebookConfig.totalChapters}
          </span>
        </div>
        <div class="flex gap-1 w-full h-2 rounded-full overflow-hidden" style="background-color: var(--color-border-light);">
          {partProgress.map((pp) => (
            <div class="flex gap-0.5" style={`flex: ${pp.total}; display: flex;`}>
              {Array.from({ length: pp.total }).map((_, i) => (
                <div
                  class="flex-1 rounded-sm"
                  style={`background-color: ${i < pp.published ? 'var(--color-accent)' : 'var(--color-border)'};`}
                />
              ))}
            </div>
          ))}
        </div>
        <div class="flex justify-between mt-1">
          {ebookConfig.parts.map(p => (
            <span class="text-[0.6rem]" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
              Pt {p.number}
            </span>
          ))}
        </div>
      </div>

      <!-- Recently published strip -->
      {latestPublished.length > 0 && (
        <div class="mb-16" data-animate>
          <span class="section-label block mb-4">Recently Published</span>
          <div class="flex overflow-x-auto gap-4 pb-2 -mx-2 px-2" style="scrollbar-width: thin;">
            {latestPublished.slice(0, 5).map(ch => (
              <a
                href={`/ebook/${ch.slug}`}
                class="shrink-0 w-56 block rounded-lg p-4 transition-colors"
                style={`border: 1px solid var(--color-border); background-color: var(--color-surface);`}
              >
                <span class="tag-editorial block mb-2">
                  {ch.data.chapter === 0 ? 'Front Matter' : `Chapter ${ch.data.chapter}`}
                </span>
                <span
                  class="block text-sm font-medium leading-snug hover-underline"
                  style="font-family: var(--font-heading); color: var(--color-text);"
                >
                  {ch.data.title}
                </span>
                <span class="block mt-2 text-xs" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
                  {ch.data.lastUpdated}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Front matter -->
      {frontMatter.length > 0 && (
        <div class="mb-12" data-animate>
          <span class="section-label block mb-4">Front Matter</span>
          <div class="space-y-1">
            {frontMatter.map(ch => (
              <div class="py-3" style="border-bottom: 1px solid var(--color-border-light);">
                {ch.data.status === 'published' ? (
                  <a href={`/ebook/${ch.slug}`} class="dot-leader group">
                    <span class="hover-underline" style="font-family: var(--font-heading); color: var(--color-text);">
                      {ch.data.title}
                    </span>
                    <span class="shrink-0 ml-2 text-sm" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
                      {ch.data.estimatedReadTime}
                    </span>
                  </a>
                ) : (
                  <div class="dot-leader" style="opacity: 0.4;">
                    <span style="font-family: var(--font-heading); color: var(--color-text-secondary);">
                      {ch.data.title}
                    </span>
                    <span class="shrink-0 ml-2 text-xs" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
                      Coming Soon
                    </span>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Table of Contents by Part -->
      <div class="space-y-14" data-stagger>
        {partChapters.map(part => (
          <section>
            <div class="flex items-baseline gap-3 mb-5">
              <span
                class="text-xl font-bold"
                style="font-family: var(--font-heading); color: var(--color-accent);"
              >
                Part {part.number}
              </span>
              <span
                class="text-xl font-bold"
                style="font-family: var(--font-heading); color: var(--color-text);"
              >
                {part.title}
              </span>
            </div>

            <div class="space-y-0">
              {part.chapters.map((ch) => (
                <div class="py-3" style="border-bottom: 1px solid var(--color-border-light);">
                  {ch.data.status === 'published' ? (
                    <a href={`/ebook/${ch.slug}`} class="dot-leader group">
                      <span
                        class="shrink-0 text-lg mr-3"
                        style="font-family: var(--font-mono); color: var(--color-text-secondary); min-width: 2rem; display: inline-block;"
                      >
                        {String(ch.data.chapter).padStart(2, '0')}
                      </span>
                      <span
                        class="hover-underline"
                        style="font-family: var(--font-heading); color: var(--color-text);"
                      >
                        {ch.data.title}
                      </span>
                      <span
                        class="shrink-0 ml-2 text-sm hidden sm:inline"
                        style="color: var(--color-text-secondary); font-family: var(--font-mono);"
                      >
                        {ch.data.estimatedReadTime}
                        {ch.data.substackUrl && !ch.data.free && (
                          <span style="color: var(--color-accent); margin-left: 0.5rem;">&#9679; Subscribers</span>
                        )}
                      </span>
                    </a>
                  ) : (
                    <div class="dot-leader" style="opacity: 0.4;">
                      <span
                        class="shrink-0 text-lg mr-3"
                        style="font-family: var(--font-mono); color: var(--color-text-secondary); min-width: 2rem; display: inline-block;"
                      >
                        {String(ch.data.chapter).padStart(2, '0')}
                      </span>
                      <span style="font-family: var(--font-heading); color: var(--color-text-secondary);">
                        {ch.data.title}
                      </span>
                      <span
                        class="shrink-0 ml-2 text-xs"
                        style="color: var(--color-text-secondary); font-family: var(--font-mono);"
                      >
                        Coming Soon
                      </span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Newsletter CTA -->
      <div
        class="mt-20 p-8 rounded-xl text-center"
        style="border: 1px solid var(--color-border); background: var(--color-surface);"
        data-animate
      >
        <span class="section-label block mb-3">Stay Updated</span>
        <h3
          class="text-xl font-bold mb-2"
          style="font-family: var(--font-heading); color: var(--color-text);"
        >
          New chapters delivered to your inbox
        </h3>
        <p
          class="text-sm mb-5 max-w-md mx-auto"
          style="font-family: var(--font-body); color: var(--color-text-secondary);"
        >
          Subscribe to get full chapters as they publish, plus production
          war stories that don't make it into the book.
        </p>
        <a
          href="https://newsletter.kirankbs.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-all arrow-link"
          style="font-family: var(--font-heading); background: var(--color-accent); color: var(--color-bg);"
        >
          Subscribe on Substack <span class="arrow">&rarr;</span>
        </a>
      </div>

    </div>
</BaseLayout>
