---
import EbookLayout from '../../layouts/EbookLayout.astro';
import SubscribeCTA from '../../components/ebook/SubscribeCTA.astro';
import { siteConfig } from '../../site.config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const chapters = await getCollection('ebook');
  return chapters.map(chapter => ({
    params: { slug: chapter.slug },
    props: { chapter },
  }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const isDraft = chapter.data.status !== 'published';
const isFree = chapter.data.free === true || chapter.data.chapter === 0;
const isGated = !isDraft && !isFree && !!chapter.data.substackUrl;
---

<EbookLayout
  title={chapter.data.title}
  description={chapter.data.excerpt}
  chapter={chapter.data.chapter}
  part={chapter.data.part}
  partTitle={chapter.data.partTitle}
  lastUpdated={chapter.data.lastUpdated}
  estimatedReadTime={chapter.data.estimatedReadTime}
  blogPostRef={chapter.data.blogPostRef}
  dataset={chapter.data.dataset}
  data-chapter={chapter.data.chapter}
>
  {isDraft ? (
    <div class="py-16 text-center">
      <span
        class="inline-block px-4 py-2 rounded-full text-sm font-medium mb-6"
        style="background-color: color-mix(in srgb, var(--color-accent) 15%, transparent); color: var(--color-accent);"
      >
        Coming Soon
      </span>
      <p class="text-lg mb-2" style="color: var(--color-text-secondary); max-width: 28rem; margin-left: auto; margin-right: auto;">
        This chapter is currently being written.
      </p>
      <p style="color: var(--color-text-secondary);">
        Subscribe to the <a href="https://newsletter.kirankbs.com/" class="hover-underline" style="color: var(--color-accent-secondary);">newsletter</a> to get notified when new chapters drop.
      </p>
    </div>
  ) : isGated ? (
    <div class="prose prose-ebook max-w-none">
      <Content />
    </div>
    <SubscribeCTA
      chapterTitle={chapter.data.title}
      chapterNumber={chapter.data.chapter}
      substackUrl={chapter.data.substackUrl!}
      learningObjectives={chapter.data.learningObjectives}
    />
  ) : (
    <Content />
    <div
      class="mt-12 p-6 sm:p-8 rounded-xl text-center"
      style="border: 1px solid var(--color-border); border-top: 2px solid var(--color-accent); background: var(--color-surface);"
    >
      <p
        class="text-base mb-5"
        style="font-family: var(--font-body); color: var(--color-text-secondary);"
      >
        Enjoying the book? Subscribe to get notified when new chapters drop.
      </p>
      <a
        href={siteConfig.social.newsletter}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-all arrow-link"
        style="font-family: var(--font-heading); background: var(--color-accent); color: var(--color-bg);"
      >
        Subscribe <span class="arrow">&rarr;</span>
      </a>
    </div>
  )}
</EbookLayout>
