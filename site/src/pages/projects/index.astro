---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Projects | Kiran Kumar" description="Data engineering architecture case studies and real-world implementations.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <PageHeader title="Projects" subtitle="Architecture case studies and real-world implementations of data platform solutions." />

    <div data-stagger>
      {projects.map((project) => (
        <a href={`/projects/${project.slug}`} class="block group">
          <article
            class="card-hover py-8"
            style={`border-bottom: 1px solid var(--color-border);`}
          >
            <h2
              class="text-2xl font-bold mb-3"
              style={`font-family: var(--font-heading); color: var(--color-text);`}
            >
              {project.data.title}
            </h2>

            <hr
              class="mb-4"
              style={`border: none; height: 1px; background: var(--color-border-light); width: 4rem;`}
            />

            <p class="mb-4 text-base" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
              {project.data.excerpt}
            </p>

            <div class="flex items-center justify-between">
              <div class="tag-editorial">
                {project.data.tags.map((tag: string, i: number) => (
                  <Fragment>
                    {i > 0 && <span class="mx-2" style="color: var(--color-border);">/</span>}
                    <span>{tag}</span>
                  </Fragment>
                ))}
              </div>

              <span
                class="arrow-link text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                style={`font-family: var(--font-heading); color: var(--color-accent);`}
              >
                Read Case Study <span class="arrow">&rarr;</span>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>

  </div>
</BaseLayout>
