---
import BaseLayout from '../layouts/BaseLayout.astro';
import { timeline, skills } from '../data/about.js';
---

<BaseLayout title="About | Kiran Kumar" description="Data Engineer specializing in Apache Spark, Delta Lake, and Databricks on Azure.">
  <div class="min-h-screen bg-white dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <div class="mb-12">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-6">
          <img
            src="/profile.jpeg"
            alt="Kiran Kumar"
            class="w-32 h-32 rounded-full object-cover object-top border-4 border-white dark:border-slate-800 shadow-lg flex-shrink-0"
          />
          <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">About Me</h1>
        </div>
        <div class="space-y-4">
          <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            I'm a Data Engineer specializing in building scalable, efficient data platforms that drive business value.
            With deep expertise in Apache Spark, Delta Lake, and Databricks on Azure, I architect lakehouse solutions
            that prioritize data governance, cost optimization, and performance.
          </p>
          <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            My approach combines technical excellence with business acumen, ensuring that data infrastructure
            not only scales but also delivers measurable ROI through intelligent design and implementation.
          </p>
        </div>
      </div>

      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Professional Philosophy</h2>
        <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6">
          <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
            Data engineering is not just about moving data — it's about creating robust, maintainable systems
            that enable organizations to make data-driven decisions at scale. I believe in:
          </p>
          <ul class="mt-4 space-y-2 text-slate-700 dark:text-slate-300">
            {[
              'Architecture-first thinking: Building foundations that scale',
              'Cost-conscious engineering: Optimizing for performance and budget',
              'Data governance by design: Security and quality from day one',
              'Continuous learning: Staying ahead in a rapidly evolving field',
            ].map(item => (
              <li class="flex items-start">
                <span class="text-cyan-600 dark:text-cyan-400 mr-2">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Career Journey</h2>
        <div class="space-y-6">
          {timeline.map((item: any, index: number) => (
            <div class="relative pl-8 pb-8 border-l-2 border-slate-200 dark:border-slate-800 last:pb-0 last:border-l-0">
              <div class="absolute -left-2 top-0 w-4 h-4 rounded-full bg-cyan-600 dark:bg-cyan-400"></div>
              <p class="text-sm text-slate-500 dark:text-slate-400 mb-1">{item.year}</p>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white">{item.role}</h3>
              <p class="text-cyan-600 dark:text-cyan-400 font-medium mb-2">{item.company}</p>
              <p class="text-slate-600 dark:text-slate-400">{item.description}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Technical Expertise</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {skills.map((skillGroup: any) => (
            <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">{skillGroup.category}</h3>
              <div class="flex flex-wrap gap-2">
                {skillGroup.items.map((skill: string) => (
                  <span class="px-3 py-1 bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-300 rounded-lg text-sm font-medium">{skill}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
