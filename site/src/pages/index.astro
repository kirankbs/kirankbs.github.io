---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataFlowHero from '../components/DataFlowHero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { ebookConfig } from '../data/ebook';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
const projects = (await getCollection('projects')).slice(0, 2);

const ebookChapters = await getCollection('ebook');
const publishedCount = ebookChapters.filter(c => c.data.status === 'published').length;
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative min-h-[85vh] flex items-center overflow-hidden dot-grid">
    <DataFlowHero />
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20" data-hero-stagger>
      <h1 class="text-7xl sm:text-8xl font-bold tracking-tight mb-4" style="font-family: var(--font-heading);">
        <span class="gradient-text">Kiran Kumar</span>
      </h1>
      <p class="text-xl sm:text-2xl mb-6" style="font-family: var(--font-body-serif, var(--font-body)); color: var(--color-text-secondary);">
        Staff Data Engineer
      </p>
      <p class="text-lg max-w-2xl mb-10" style="font-family: var(--font-body); color: var(--color-text-secondary);">
        I build lakehouse platforms on Spark, Delta Lake, and Databricks — then write about the failures that no getting-started guide covers.
      </p>
      <div class="flex flex-col sm:flex-row gap-6">
        <a href="/blog" class="arrow-link" style="color: var(--color-text);">
          Read Articles <span class="arrow">&rarr;</span>
        </a>
        <a href="/projects" class="arrow-link" style="color: var(--color-text);">
          View Projects <span class="arrow">&rarr;</span>
        </a>
        <a href="/ebook" class="arrow-link" style="color: var(--color-text);">
          Read the eBook <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="mb-10">
      <span class="section-label">Latest Articles</span>
      <div class="rule-line"></div>
    </div>

    <div data-stagger>
      <BlogCard post={posts[0]} featured />
    </div>

    <div class="grid md:grid-cols-2 gap-6" data-stagger>
      {posts.slice(1).map((post) => (
        <BlogCard post={post} />
      ))}
    </div>

    <div class="mt-8">
      <a href="/blog" class="arrow-link" style="color: var(--color-text-secondary);">
        View all articles <span class="arrow">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- eBook Callout -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <a href="/ebook" class="block p-6 rounded-lg border-l-4" style={`border-left-color: var(--color-accent); border-top: 1px solid var(--color-border); border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface);`} data-animate>
      <p class="text-sm font-medium tracking-wide uppercase mb-1" style="color: var(--color-accent);">
        Free eBook
      </p>
      <h3 class="text-xl font-bold mb-1" style="font-family: var(--font-heading); color: var(--color-text);">
        {ebookConfig.title}
      </h3>
      <p class="text-sm mb-2" style="font-family: var(--font-body); color: var(--color-text-secondary);">
        {ebookConfig.subtitle}
      </p>
      <p class="text-sm" style="color: var(--color-text-secondary);">
        Early Access — {publishedCount} chapters published
      </p>
    </a>
  </section>

  <!-- Featured Projects -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20" style="border-top: 1px solid var(--color-border);">
    <div class="mb-10">
      <span class="section-label">Featured Projects</span>
      <div class="rule-line"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8" data-stagger>
      {projects.map((project) => (
        <a href={`/projects/${project.slug}`} class="group block card-hover rounded-lg p-6 border" style={`border-color: var(--color-border); background: var(--color-surface);`}>
          <span class="text-sm" style="color: var(--color-text-secondary);">{project.data.date}</span>
          <h3 class="text-2xl font-bold mt-2 mb-3 hover-underline inline-block" style={`font-family: var(--font-heading); color: var(--color-text);`}>
            {project.data.title}
          </h3>
          <p class="text-sm mb-4" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
            {project.data.excerpt}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string, i: number) => (
              <span>
                <span class="tag-editorial">{tag}</span>
                {i < project.data.tags.length - 1 && <span class="tag-editorial mx-1">/</span>}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8">
      <a href="/projects" class="arrow-link" style="color: var(--color-text-secondary);">
        View all projects <span class="arrow">&rarr;</span>
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-2xl sm:text-3xl leading-relaxed" style="font-family: var(--font-body-serif, var(--font-body)); color: var(--color-text);">
      <span style="color: var(--color-text-secondary);">—</span>
      Always open to connecting with fellow engineers, swapping war stories, and talking shop about data platforms.
      <span style="color: var(--color-text-secondary);">—</span>
    </p>
    <div class="mt-8">
      <a href="/contact" class="arrow-link" style="color: var(--color-text);">
        Get in touch <span class="arrow">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>
