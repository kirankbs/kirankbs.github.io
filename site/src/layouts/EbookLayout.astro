---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ebookConfig } from '../data/ebook';

interface Props {
  title: string;
  description: string;
  chapter: number;
  part?: number;
  partTitle?: string;
  lastUpdated?: string;
  estimatedReadTime?: string;
  blogPostRef?: string;
  dataset?: string;
}

const {
  title,
  description,
  chapter,
  part,
  partTitle,
  lastUpdated,
  estimatedReadTime,
  blogPostRef,
  dataset,
} = Astro.props;

const allChapters = (await getCollection('ebook'))
  .sort((a, b) => a.data.chapter - b.data.chapter);

const currentIndex = allChapters.findIndex(c => c.data.chapter === chapter);
const prevChapter = currentIndex > 0 ? allChapters[currentIndex - 1] : null;
const nextChapter = currentIndex < allChapters.length - 1 ? allChapters[currentIndex + 1] : null;

const publishedCount = allChapters.filter(c => c.data.status === 'published').length;
---

<BaseLayout title={`${title} | eBook`} description={description}>
  <div class="min-h-screen bg-white dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400 mb-8">
        <a href="/ebook" class="hover:text-cyan-600 dark:hover:text-cyan-400">eBook</a>
        {part && partTitle && (
          <>
            <span>/</span>
            <span>Part {part}: {partTitle}</span>
          </>
        )}
        <span>/</span>
        <span class="text-slate-700 dark:text-slate-300">
          {chapter === 0 ? title : `Chapter ${chapter}`}
        </span>
      </nav>

      <!-- Chapter header -->
      <header class="mb-10">
        {chapter > 0 && (
          <div class="text-sm font-medium text-cyan-600 dark:text-cyan-400 mb-2">
            Chapter {chapter} of {ebookConfig.totalChapters}
          </div>
        )}
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">{title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
          {estimatedReadTime && <span>{estimatedReadTime}</span>}
          {lastUpdated && (
            <>
              <span>·</span>
              <span>Updated {lastUpdated}</span>
            </>
          )}
          {dataset && (
            <>
              <span>·</span>
              <span>Dataset: {dataset}</span>
            </>
          )}
        </div>
        {blogPostRef && (
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            Expands on the blog post: <a href={`/blog/${blogPostRef}`} class="text-cyan-600 dark:text-cyan-400 hover:underline">{blogPostRef}</a>
          </p>
        )}
      </header>

      <!-- Chapter content -->
      <div class="prose prose-slate dark:prose-invert max-w-none">
        <slot />
      </div>

      <!-- Chapter navigation -->
      <footer class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div class="flex justify-between items-start">
          <div>
            {prevChapter && (
              <a
                href={`/ebook/${prevChapter.slug}`}
                class="group inline-flex flex-col"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                  &larr; Previous
                </span>
                <span class="text-slate-900 dark:text-white font-medium group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                  {prevChapter.data.chapter === 0 ? prevChapter.data.title : `Ch ${prevChapter.data.chapter}: ${prevChapter.data.title}`}
                </span>
              </a>
            )}
          </div>
          <div class="text-right">
            {nextChapter && (
              <a
                href={`/ebook/${nextChapter.slug}`}
                class="group inline-flex flex-col items-end"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                  Next &rarr;
                </span>
                <span class="text-slate-900 dark:text-white font-medium group-hover:text-cyan-600 dark:group-hover:text-cyan-400">
                  {nextChapter.data.chapter === 0 ? nextChapter.data.title : `Ch ${nextChapter.data.chapter}: ${nextChapter.data.title}`}
                </span>
              </a>
            )}
          </div>
        </div>

        <div class="mt-8 text-center">
          <a href="/ebook" class="text-sm text-cyan-600 dark:text-cyan-400 hover:underline">
            &larr; Back to Table of Contents
          </a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
