---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { getCollection } from 'astro:content';
import { ebookConfig } from '../data/ebook';

interface Props {
  title: string;
  description: string;
  chapter: number;
  part?: number;
  partTitle?: string;
  lastUpdated?: string;
  estimatedReadTime?: string;
  blogPostRef?: string;
  dataset?: string;
}

const {
  title,
  description,
  chapter,
  part,
  partTitle,
  lastUpdated,
  estimatedReadTime,
  blogPostRef,
  dataset,
} = Astro.props;

const allChapters = (await getCollection('ebook'))
  .sort((a, b) => a.data.chapter - b.data.chapter);

const currentIndex = allChapters.findIndex(c => c.data.chapter === chapter);
const prevChapter = currentIndex > 0 ? allChapters[currentIndex - 1] : null;
const nextChapter = currentIndex < allChapters.length - 1 ? allChapters[currentIndex + 1] : null;
---

<BaseLayout title={`${title} | eBook`} description={description}>
  <ReadingProgress />

  <div class="grid grid-cols-1 lg:grid-cols-[250px_1fr] max-w-6xl mx-auto">

      <!-- Sidebar TOC (desktop) -->
      <aside
        class="hidden lg:block sticky top-0 h-screen overflow-y-auto py-12 pl-6 pr-4"
        style="border-right: 1px solid var(--color-border-light);"
      >
        <a
          href="/ebook"
          class="section-label block mb-6 hover-underline"
          style="color: var(--color-accent);"
        >
          &larr; Table of Contents
        </a>

        <nav class="space-y-1">
          {allChapters.map(ch => {
            const isCurrent = ch.data.chapter === chapter;
            const isPublished = ch.data.status === 'published';
            const label = ch.data.chapter === 0
              ? ch.data.title
              : `${String(ch.data.chapter).padStart(2, '0')}. ${ch.data.title}`;

            return isPublished ? (
              <a
                href={`/ebook/${ch.slug}`}
                class="block py-1.5 text-sm leading-snug transition-colors truncate"
                style={`
                  font-family: var(--font-heading);
                  color: ${isCurrent ? 'var(--color-accent)' : 'var(--color-text-secondary)'};
                  font-weight: ${isCurrent ? '600' : '400'};
                  ${isCurrent ? 'border-left: 2px solid var(--color-accent); padding-left: 0.75rem;' : 'padding-left: calc(0.75rem + 2px);'}
                `}
              >
                {label}
              </a>
            ) : (
              <span
                class="block py-1.5 text-sm leading-snug truncate"
                style="font-family: var(--font-heading); color: var(--color-text-secondary); opacity: 0.35; padding-left: calc(0.75rem + 2px);"
              >
                {label}
              </span>
            );
          })}
        </nav>
      </aside>

      <!-- Main content -->
      <main class="px-4 sm:px-8 lg:px-12 py-12 max-w-3xl mx-auto w-full">

        <!-- Breadcrumb -->
        <nav class="flex items-center flex-wrap gap-1.5 text-sm mb-10" style="font-family: var(--font-mono);">
          <a
            href="/ebook"
            class="hover-underline"
            style="color: var(--color-accent);"
          >eBook</a>
          {part && partTitle && (
            <>
              <span style="color: var(--color-text-secondary);">/</span>
              <span style="color: var(--color-text-secondary);">Part {part}</span>
            </>
          )}
          <span style="color: var(--color-text-secondary);">/</span>
          <span style="color: var(--color-text);">
            {chapter === 0 ? title : `Chapter ${chapter}`}
          </span>
        </nav>

        <!-- Chapter header with watermark -->
        <header class="mb-12 relative overflow-hidden">
          {chapter > 0 && (
            <div
              class="absolute -top-8 -left-4 select-none pointer-events-none"
              style="font-family: var(--font-heading); font-size: 8rem; font-weight: 900; line-height: 1; color: var(--color-text); opacity: 0.05;"
              data-chapter={chapter}
            >
              {String(chapter).padStart(2, '0')}
            </div>
          )}
          <div class="relative">
            {chapter > 0 && (
              <div class="section-label mb-3" style="color: var(--color-accent);">
                Chapter {chapter} of {ebookConfig.totalChapters}
              </div>
            )}
            <h1
              class="text-4xl sm:text-5xl font-bold mb-4"
              style="font-family: var(--font-heading); color: var(--color-text);"
            >{title}</h1>
            <div class="flex flex-wrap items-center gap-3 text-sm" style="color: var(--color-text-secondary); font-family: var(--font-mono);">
              {estimatedReadTime && <span>{estimatedReadTime}</span>}
              {lastUpdated && (
                <>
                  <span>&middot;</span>
                  <span>Updated {lastUpdated}</span>
                </>
              )}
              {dataset && (
                <>
                  <span>&middot;</span>
                  <span>Dataset: {dataset}</span>
                </>
              )}
            </div>
            {blogPostRef && (
              <p class="mt-3 text-sm" style="color: var(--color-text-secondary);">
                Expands on: <a href={`/blog/${blogPostRef}`} class="hover-underline" style="color: var(--color-accent-secondary);">{blogPostRef}</a>
              </p>
            )}
            <div class="rule-line w-16 mt-6"></div>
          </div>
        </header>

        <!-- Chapter content -->
        <div class="prose prose-ebook max-w-none">
          <slot />
        </div>

        <!-- Chapter navigation footer -->
        <footer class="mt-20 pt-10" style="border-top: 1px solid var(--color-border);">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevChapter ? (
              <a
                href={`/ebook/${prevChapter.slug}`}
                class="group block p-5 rounded-lg transition-colors"
                style="border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); background-color: var(--color-surface);"
              >
                <span class="section-label block mb-2">&larr; Previous</span>
                <span
                  class="block font-medium leading-snug"
                  style="font-family: var(--font-heading); color: var(--color-text);"
                >
                  {prevChapter.data.chapter === 0 ? prevChapter.data.title : `Ch ${prevChapter.data.chapter}: ${prevChapter.data.title}`}
                </span>
              </a>
            ) : <div />}

            {nextChapter ? (
              <a
                href={`/ebook/${nextChapter.slug}`}
                class="group block p-5 rounded-lg text-right transition-colors"
                style="border: 1px solid var(--color-border); border-right: 3px solid var(--color-accent); background-color: var(--color-surface);"
              >
                <span class="section-label block mb-2">Next &rarr;</span>
                <span
                  class="block font-medium leading-snug"
                  style="font-family: var(--font-heading); color: var(--color-text);"
                >
                  {nextChapter.data.chapter === 0 ? nextChapter.data.title : `Ch ${nextChapter.data.chapter}: ${nextChapter.data.title}`}
                </span>
              </a>
            ) : <div />}
          </div>

          <div class="mt-8 text-center">
            <a href="/ebook" class="hover-underline text-sm" style="color: var(--color-accent);">
              &larr; Back to Table of Contents
            </a>
          </div>
        </footer>

      </main>
    </div>
</BaseLayout>
