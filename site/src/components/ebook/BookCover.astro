---
import { ebookConfig } from '../../data/ebook';

interface Props {
  publishedCount: number;
}

const { publishedCount } = Astro.props;
---

<div class="book-cover-wrapper" data-animate>
  <div class="book-cover">
    <div class="cover-bg-texture"></div>

    <div class="cover-side-accent">
      <span class="cover-side-text">Production Engineering Series</span>
    </div>

    <div class="cover-content">
      <div class="cover-series-tag">A Practitioner's Guide</div>

      <div class="cover-title-block">
        <h2 class="cover-title">
          <em>Spark</em>, <em>Delta&nbsp;Lake</em>,<br />
          and <em>Databricks</em><br />
          in Production
        </h2>
        <div class="cover-title-rule"></div>
        <p class="cover-subtitle">{ebookConfig.subtitle}</p>
      </div>

      <!-- Central Illustration -->
      <div class="cover-illustration">
        <svg viewBox="0 -20 480 330" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <filter id="gl-a" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="gl-t" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="gl-w" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="12" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <linearGradient id="sa" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#C8963E" stop-opacity="0"/>
              <stop offset="25%" stop-color="#C8963E" stop-opacity="0.8"/>
              <stop offset="75%" stop-color="#E2B44C" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#E2B44C" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="st" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#2D8E8E" stop-opacity="0"/>
              <stop offset="30%" stop-color="#2D8E8E" stop-opacity="0.7"/>
              <stop offset="70%" stop-color="#3BA8A8" stop-opacity="0.7"/>
              <stop offset="100%" stop-color="#3BA8A8" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="sp" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#7C5CBF" stop-opacity="0"/>
              <stop offset="25%" stop-color="#7C5CBF" stop-opacity="0.65"/>
              <stop offset="75%" stop-color="#9B7DD4" stop-opacity="0.65"/>
              <stop offset="100%" stop-color="#9B7DD4" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="tf" x1="50%" y1="0%" x2="50%" y2="100%">
              <stop offset="0%" stop-color="#C8963E" stop-opacity="0.04"/>
              <stop offset="50%" stop-color="#2D8E8E" stop-opacity="0.03"/>
              <stop offset="100%" stop-color="#7C5CBF" stop-opacity="0.04"/>
            </linearGradient>
            <radialGradient id="na" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#E8C44E" stop-opacity="1"/>
              <stop offset="50%" stop-color="#C8963E" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#C8963E" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="nt" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#5EC4C4" stop-opacity="1"/>
              <stop offset="50%" stop-color="#2D8E8E" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#2D8E8E" stop-opacity="0"/>
            </radialGradient>
            <radialGradient id="np" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#B69DE0" stop-opacity="1"/>
              <stop offset="50%" stop-color="#7C5CBF" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#7C5CBF" stop-opacity="0"/>
            </radialGradient>
            <clipPath id="dc">
              <polygon points="240,18 52,278 428,278"/>
            </clipPath>
          </defs>

          <!-- Grid -->
          <g opacity="0.045">
            <line x1="60" y1="0" x2="60" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="120" y1="0" x2="120" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="180" y1="0" x2="180" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="240" y1="0" x2="240" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="300" y1="0" x2="300" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="360" y1="0" x2="360" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="420" y1="0" x2="420" y2="310" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="0" y1="40" x2="480" y2="40" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="0" y1="100" x2="480" y2="100" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="0" y1="160" x2="480" y2="160" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="0" y1="220" x2="480" y2="220" stroke="#F0EDE4" stroke-width="0.5"/>
            <line x1="0" y1="280" x2="480" y2="280" stroke="#F0EDE4" stroke-width="0.5"/>
          </g>

          <!-- Triangle fill + frame -->
          <polygon points="240,18 52,278 428,278" fill="url(#tf)"/>
          <polygon points="240,18 52,278 428,278" fill="none" stroke="rgba(200,150,62,0.3)" stroke-width="1.5"/>
          <polygon points="240,20 54,277 426,277" fill="none" stroke="rgba(200,150,62,0.1)" stroke-width="0.5"/>

          <!-- Contours + data layers -->
          <g clip-path="url(#dc)">
            <polygon points="240,42 76,264 404,264" fill="none" stroke="rgba(200,150,62,0.14)" stroke-width="0.8"/>
            <polygon points="240,68 102,248 378,248" fill="none" stroke="rgba(45,142,142,0.18)" stroke-width="0.8"/>
            <polygon points="240,96 128,232 352,232" fill="none" stroke="rgba(124,92,191,0.16)" stroke-width="0.8"/>
            <polygon points="240,124 154,216 326,216" fill="none" stroke="rgba(200,150,62,0.14)" stroke-width="0.8"/>
            <polygon points="240,152 180,200 300,200" fill="none" stroke="rgba(45,142,142,0.14)" stroke-width="0.8"/>
            <line x1="72" y1="245" x2="408" y2="245" stroke="rgba(45,142,142,0.12)" stroke-width="12" stroke-linecap="round"/>
            <line x1="115" y1="210" x2="365" y2="210" stroke="rgba(124,92,191,0.1)" stroke-width="10" stroke-linecap="round"/>
            <line x1="158" y1="175" x2="322" y2="175" stroke="rgba(200,150,62,0.1)" stroke-width="8" stroke-linecap="round"/>
            <path d="M 240,55 Q 260,50 280,80 Q 320,130 370,200 Q 400,245 410,260" fill="none" stroke="rgba(200,150,62,0.1)" stroke-width="0.7"/>
            <path d="M 240,55 Q 220,50 200,80 Q 160,130 110,200 Q 80,245 70,260" fill="none" stroke="rgba(200,150,62,0.1)" stroke-width="0.7"/>
            <path d="M 150,260 Q 200,240 240,180 Q 280,240 330,260" fill="none" stroke="rgba(45,142,142,0.1)" stroke-width="0.7"/>
            <path d="M 100,260 Q 170,220 240,150 Q 310,220 380,260" fill="none" stroke="rgba(124,92,191,0.07)" stroke-width="0.6"/>
          </g>

          <!-- Data streams -->
          <g>
            <path d="M 0,190 Q 18,192 52,278" fill="none" stroke="url(#st)" stroke-width="1.8"/>
            <path d="M 0,205 Q 22,205 52,278" fill="none" stroke="url(#st)" stroke-width="1.2" stroke-dasharray="5,5"/>
            <path d="M 0,175 Q 14,180 52,278" fill="none" stroke="url(#st)" stroke-width="0.8"/>
            <path d="M 0,220 Q 28,218 52,278" fill="none" stroke="url(#st)" stroke-width="0.6" stroke-dasharray="3,7"/>
            <path d="M 0,160 Q 10,168 52,278" fill="none" stroke="url(#st)" stroke-width="0.5"/>
          </g>
          <g>
            <path d="M 175,0 Q 202,6 240,18" fill="none" stroke="url(#sa)" stroke-width="1.8"/>
            <path d="M 195,0 Q 214,8 240,18" fill="none" stroke="url(#sa)" stroke-width="1.2" stroke-dasharray="5,5"/>
            <path d="M 155,0 Q 192,4 240,18" fill="none" stroke="url(#sa)" stroke-width="0.8"/>
            <path d="M 270,0 Q 258,6 240,18" fill="none" stroke="url(#sa)" stroke-width="1.5"/>
            <path d="M 295,0 Q 272,5 240,18" fill="none" stroke="url(#sa)" stroke-width="0.9" stroke-dasharray="4,6"/>
            <path d="M 315,0 Q 282,4 240,18" fill="none" stroke="url(#sa)" stroke-width="0.5"/>
          </g>
          <g>
            <path d="M 428,278 Q 448,272 480,245" fill="none" stroke="url(#sp)" stroke-width="1.8"/>
            <path d="M 428,278 Q 450,278 480,258" fill="none" stroke="url(#sp)" stroke-width="1.2" stroke-dasharray="5,5"/>
            <path d="M 428,278 Q 444,268 480,232" fill="none" stroke="url(#sp)" stroke-width="0.8"/>
            <path d="M 428,278 Q 452,282 480,272" fill="none" stroke="url(#sp)" stroke-width="0.6" stroke-dasharray="3,7"/>
            <path d="M 428,278 Q 440,262 480,218" fill="none" stroke="url(#sp)" stroke-width="0.5"/>
          </g>

          <!-- Internal flows -->
          <g opacity="0.7">
            <path d="M 52,278 Q 100,220 146,148 Q 170,108 200,65 Q 220,38 240,18" fill="none" stroke="rgba(45,142,142,0.3)" stroke-width="1.2" stroke-dasharray="6,4"/>
            <path d="M 240,18 Q 260,38 300,100 Q 340,165 380,225 Q 410,260 428,278" fill="none" stroke="rgba(200,150,62,0.3)" stroke-width="1.2" stroke-dasharray="6,4"/>
            <path d="M 52,278 Q 150,265 240,258 Q 330,265 428,278" fill="none" stroke="rgba(124,92,191,0.25)" stroke-width="1.2" stroke-dasharray="6,4"/>
            <path d="M 120,245 Q 180,190 240,175 Q 300,190 360,245" fill="none" stroke="rgba(200,150,62,0.15)" stroke-width="0.8" stroke-dasharray="4,6"/>
            <path d="M 150,260 Q 195,200 240,150" fill="none" stroke="rgba(45,142,142,0.15)" stroke-width="0.7" stroke-dasharray="3,5"/>
            <path d="M 330,260 Q 285,200 240,150" fill="none" stroke="rgba(124,92,191,0.15)" stroke-width="0.7" stroke-dasharray="3,5"/>
          </g>

          <!-- Network graph -->
          <g opacity="0.5">
            <line x1="150" y1="210" x2="210" y2="160" stroke="rgba(45,142,142,0.5)" stroke-width="0.7"/>
            <line x1="210" y1="160" x2="240" y2="140" stroke="rgba(200,150,62,0.5)" stroke-width="0.7"/>
            <line x1="240" y1="140" x2="270" y2="160" stroke="rgba(200,150,62,0.5)" stroke-width="0.7"/>
            <line x1="270" y1="160" x2="330" y2="210" stroke="rgba(124,92,191,0.5)" stroke-width="0.7"/>
            <line x1="180" y1="180" x2="210" y2="160" stroke="rgba(45,142,142,0.4)" stroke-width="0.5"/>
            <line x1="300" y1="180" x2="270" y2="160" stroke="rgba(124,92,191,0.4)" stroke-width="0.5"/>
            <line x1="240" y1="200" x2="240" y2="140" stroke="rgba(200,150,62,0.35)" stroke-width="0.5"/>
            <line x1="120" y1="240" x2="150" y2="210" stroke="rgba(45,142,142,0.4)" stroke-width="0.5"/>
            <line x1="360" y1="240" x2="330" y2="210" stroke="rgba(124,92,191,0.4)" stroke-width="0.5"/>
            <line x1="200" y1="100" x2="240" y2="140" stroke="rgba(200,150,62,0.35)" stroke-width="0.5"/>
            <line x1="280" y1="100" x2="240" y2="140" stroke="rgba(200,150,62,0.35)" stroke-width="0.5"/>
          </g>

          <!-- Nodes -->
          <g>
            <circle cx="150" cy="210" r="4" fill="rgba(45,142,142,0.6)"/>
            <circle cx="150" cy="210" r="1.5" fill="rgba(94,196,196,0.8)"/>
            <circle cx="180" cy="180" r="3" fill="rgba(45,142,142,0.5)"/>
            <circle cx="120" cy="240" r="3.5" fill="rgba(45,142,142,0.5)"/>
            <circle cx="330" cy="210" r="4" fill="rgba(124,92,191,0.6)"/>
            <circle cx="330" cy="210" r="1.5" fill="rgba(182,157,224,0.8)"/>
            <circle cx="300" cy="180" r="3" fill="rgba(124,92,191,0.5)"/>
            <circle cx="360" cy="240" r="3.5" fill="rgba(124,92,191,0.5)"/>
            <circle cx="200" cy="100" r="3" fill="rgba(200,150,62,0.55)"/>
            <circle cx="280" cy="100" r="3" fill="rgba(200,150,62,0.55)"/>
            <circle cx="210" cy="160" r="3.5" fill="rgba(200,150,62,0.55)"/>
            <circle cx="210" cy="160" r="1.2" fill="rgba(232,196,78,0.8)"/>
            <circle cx="270" cy="160" r="3.5" fill="rgba(200,150,62,0.55)"/>
            <circle cx="270" cy="160" r="1.2" fill="rgba(232,196,78,0.8)"/>
            <circle cx="240" cy="200" r="3" fill="rgba(45,142,142,0.5)"/>
            <circle cx="200" cy="230" r="2.5" fill="rgba(124,92,191,0.45)"/>
            <circle cx="280" cy="230" r="2.5" fill="rgba(124,92,191,0.45)"/>
          </g>

          <!-- Central + vertex glows -->
          <g filter="url(#gl-a)">
            <circle cx="240" cy="140" r="6" fill="rgba(226,180,76,0.6)"/>
            <circle cx="240" cy="140" r="2.5" fill="#E8C44E" opacity="0.9"/>
            <circle cx="240" cy="140" r="1" fill="#FFF8E0"/>
          </g>
          <g filter="url(#gl-w)"><circle cx="240" cy="18" r="16" fill="url(#na)"/></g>
          <g filter="url(#gl-a)">
            <circle cx="240" cy="18" r="6" fill="#E8C44E" opacity="0.9"/>
            <circle cx="240" cy="18" r="2" fill="#FFF8E0"/>
          </g>
          <g filter="url(#gl-w)"><circle cx="52" cy="278" r="14" fill="url(#nt)"/></g>
          <g filter="url(#gl-t)">
            <circle cx="52" cy="278" r="5" fill="#5EC4C4" opacity="0.9"/>
            <circle cx="52" cy="278" r="2" fill="#E0FFFE"/>
          </g>
          <g filter="url(#gl-w)"><circle cx="428" cy="278" r="14" fill="url(#np)"/></g>
          <g filter="url(#gl-t)">
            <circle cx="428" cy="278" r="5" fill="#B69DE0" opacity="0.9"/>
            <circle cx="428" cy="278" r="2" fill="#F0E8FF"/>
          </g>

          <!-- Labels -->
          <text x="240" y="3" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="400" letter-spacing="2" fill="rgba(232,196,78,0.7)">SPARK</text>
          <text x="38" y="300" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="400" letter-spacing="2" fill="rgba(94,196,196,0.65)">DELTA</text>
          <text x="442" y="300" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="400" letter-spacing="2" fill="rgba(182,157,224,0.65)">DATABRICKS</text>

          <!-- Particles -->
          <g opacity="0.35">
            <circle cx="95" cy="170" r="1.3" fill="#3BA8A8"/>
            <circle cx="385" cy="170" r="1.3" fill="#9B7DD4"/>
            <circle cx="165" cy="85" r="1" fill="#C8963E"/>
            <circle cx="315" cy="85" r="1" fill="#C8963E"/>
            <circle cx="240" cy="115" r="1.2" fill="#E2B44C"/>
            <circle cx="190" cy="255" r="1" fill="#3BA8A8"/>
            <circle cx="290" cy="255" r="1" fill="#9B7DD4"/>
            <circle cx="140" cy="145" r="0.9" fill="#3BA8A8"/>
            <circle cx="340" cy="145" r="0.9" fill="#9B7DD4"/>
            <circle cx="240" cy="240" r="1" fill="#7C5CBF"/>
          </g>
        </svg>
      </div>

      <div class="cover-bottom">
        <div class="cover-bottom-rule"></div>
        <div class="cover-author-line">
          <span class="cover-author">{ebookConfig.author}</span>
          <span class="cover-edition">{ebookConfig.edition} Edition</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .book-cover-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .book-cover {
    width: 380px;
    height: 570px;
    background: #0F1319;
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    box-shadow:
      0 20px 50px rgba(0,0,0,0.35),
      0 0 0 1px rgba(255,255,255,0.04);
  }

  .book-cover::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #C8963E, #E8B44E, #C8963E);
  }

  .book-cover::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #C8963E, #E8B44E, #C8963E);
  }

  .cover-bg-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.015) 1px, transparent 0);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .cover-side-accent {
    position: absolute;
    top: 3px; left: 0; bottom: 3px;
    width: 30px;
    background: linear-gradient(180deg,
      rgba(200, 150, 62, 0.08) 0%,
      rgba(200, 150, 62, 0.03) 40%,
      rgba(200, 150, 62, 0.03) 60%,
      rgba(200, 150, 62, 0.08) 100%
    );
    border-right: 1px solid rgba(200, 150, 62, 0.12);
  }

  .cover-side-text {
    position: absolute;
    left: 9px;
    top: 50%;
    transform: rotate(-90deg) translateX(-50%);
    transform-origin: left center;
    font-family: 'Inter Tight', sans-serif;
    font-size: 5.5px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(200, 150, 62, 0.4);
    white-space: nowrap;
  }

  .cover-content {
    position: relative;
    z-index: 1;
    padding: 30px 30px 26px 44px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cover-series-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 7px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(200, 150, 62, 0.7);
    margin-bottom: 18px;
  }

  .cover-title-block { margin-bottom: 10px; }

  .cover-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-weight: 600;
    font-size: 25px;
    line-height: 1.15;
    color: #F0EDE4;
    letter-spacing: -0.2px;
  }

  .cover-title em {
    font-style: normal;
    color: #E2B44C;
  }

  .cover-title-rule {
    width: 34px;
    height: 1.5px;
    background: linear-gradient(90deg, #C8963E, transparent);
    margin: 12px 0;
  }

  .cover-subtitle {
    font-family: 'Source Serif 4', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: 12px;
    line-height: 1.45;
    color: rgba(226, 180, 76, 0.85);
  }

  .cover-illustration {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 8px 0;
  }

  .cover-illustration svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }

  .cover-bottom { margin-top: auto; }

  .cover-bottom-rule {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg,
      rgba(200, 150, 62, 0.3),
      rgba(200, 150, 62, 0.08) 70%,
      transparent
    );
    margin-bottom: 12px;
  }

  .cover-author-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .cover-author {
    font-family: 'Inter Tight', sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #F0EDE4;
  }

  .cover-edition {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(200, 150, 62, 0.65);
  }

  .cover-edition::before {
    content: '';
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C8963E;
  }

  @media (min-width: 640px) {
    .book-cover {
      width: 420px;
      height: 630px;
    }
    .cover-content { padding: 36px 36px 30px 50px; }
    .cover-title { font-size: 28px; }
    .cover-subtitle { font-size: 13px; }
  }
</style>
