---
interface Props {
  post: any;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

{featured ? (
  <a href={`/blog/${post.slug}`} class="group block card-hover border-b pb-8 mb-8" style={`border-color: var(--color-border);`}>
    <div class="grid md:grid-cols-[1fr_auto] gap-6">
      <div>
        <span class="tag-editorial">{post.data.date}</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2 mb-3 hover-underline inline-block" style={`font-family: var(--font-heading); color: var(--color-text);`}>
          {post.data.title}
        </h2>
        <p class="text-base mb-4" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
          {post.data.excerpt}
        </p>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string, i: number) => (
            <span>
              <span class="tag-editorial">{tag}</span>
              {i < post.data.tags.length - 1 && <span class="tag-editorial mx-1">/</span>}
            </span>
          ))}
        </div>
      </div>
      <div class="flex items-start">
        <span class="tag-editorial">{post.data.readTime}</span>
      </div>
    </div>
  </a>
) : (
  <a href={`/blog/${post.slug}`} class="group block card-hover rounded-lg p-6 border" style={`border-color: var(--color-border); background: var(--color-surface);`}>
    <span class="tag-editorial">{post.data.date}</span>
    <h3 class="text-xl font-bold mt-2 mb-2 hover-underline inline-block" style={`font-family: var(--font-heading); color: var(--color-text);`}>
      {post.data.title}
    </h3>
    <p class="text-sm mb-4" style={`font-family: var(--font-body); color: var(--color-text-secondary);`}>
      {post.data.excerpt}
    </p>
    <div class="flex items-center justify-between">
      <div class="flex flex-wrap gap-1">
        {post.data.tags.map((tag: string, i: number) => (
          <span>
            <span class="tag-editorial">{tag}</span>
            {i < post.data.tags.length - 1 && <span class="tag-editorial mx-1">/</span>}
          </span>
        ))}
      </div>
      <span class="tag-editorial">{post.data.readTime}</span>
    </div>
  </a>
)}
